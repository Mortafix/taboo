{
  "name": "taboo-pwa",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/build-decks.mjs && node scripts/generate-icons.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-decks.mjs && node scripts/generate-icons.mjs",
    "build": "tsc --noEmit && vite build && node scripts/finalize-service-worker.mjs",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:site": "npm run build && node --test tests/rendered-html.test.mjs",
    "data:import": "node scripts/import-decks.mjs",
    "data:check": "node scripts/build-decks.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^3.0.0",
    "animejs": "^4.5.0",
    "lucide-react": "^1.27.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "globals": "^16.4.0",
    "sharp": "^0.34.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.0.13",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
